# Stage 1: Build do aplicativo
FROM node:18-alpine AS build

# Build arguments para variáveis Vite
ARG VITE_API_SERVER=
ARG VITE_API_PORT=
ARG VITE_API_BASE_URL=/api
ARG VITE_GOOGLE_MAPS_API_KEY=
ARG NODE_ENV=production

# Configuração do diretório de trabalho
WORKDIR /app

# Copia os arquivos de configuração do package
COPY package.json package-lock.json ./

# Instala as dependências
RUN npm ci --only=production

# Copia todos os arquivos do projeto
COPY . .

# Define as variáveis de ambiente para o build
ENV VITE_API_SERVER=${VITE_API_SERVER}
ENV VITE_API_PORT=${VITE_API_PORT}
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_GOOGLE_MAPS_API_KEY=${VITE_GOOGLE_MAPS_API_KEY}
ENV NODE_ENV=${NODE_ENV}

# Compila o aplicativo para produção
RUN npm run build

# Stage 2: Servidor nginx para SPA
FROM nginx:alpine

# Instala curl, perl e ca-certificates para healthcheck, substituições e HTTPS
RUN apk add --no-cache curl perl ca-certificates && update-ca-certificates

# Remove a configuração padrão do nginx
RUN rm /etc/nginx/conf.d/default.conf

# Copia os arquivos de build do Vite para o nginx
COPY --from=build /app/dist /usr/share/nginx/html

# Copia template de configuração nginx
COPY nginx-spa-template.conf /etc/nginx/conf.d/nginx-spa-template.conf

# Copia script de entrypoint e define permissões
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Cria diretório para logs se não existir
RUN mkdir -p /var/log/nginx

# Expõe a porta 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost/health || exit 1

# Comando para iniciar com entrypoint configurável
ENTRYPOINT ["/entrypoint.sh"]
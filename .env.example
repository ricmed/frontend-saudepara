# Copie para .env.local (gitignored) antes de `npm run dev`.
# Sem VITE_USE_INTERNAL_AUTH=true o Vite encaminha login para :4000 (Keycloak legado).

VITE_USE_INTERNAL_AUTH=true
VITE_API_SERVER=http://localhost
VITE_API_PORT=3000
VITE_API_BASE_URL=/api

# Opcional. Sem chave, mapas Google não carregam.
# VITE_GOOGLE_MAPS_API_KEY=

# Configurações do SPA para deploy

# === Configurações de Proxy ===
# Habilitar proxy reverso para APIs
NGINX_PROXY_BACKEND=yes

# URL do backend para proxy de /api/
NGINX_PROXY_URL=http://backend:3000

# URL específica para /api-auth (geralmente Keycloak ou similar)
API_AUTH_URL=http://172.32.1.98:4000

# === Configurações de Debug ===
# Habilitar logs de debug
DEBUG=false

# === Variáveis do Frontend (Vite) ===
# Chave da API do Google Maps
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Servidor da API
VITE_API_SERVER=https://api.yourdomain.com

# Porta da API
VITE_API_PORT=3000

# === Configurações de Build ===
NODE_ENV=production

# === Exemplos de configuração para diferentes ambientes ===

# DESENVOLVIMENTO LOCAL:
# NGINX_PROXY_BACKEND=no
# API_AUTH_URL=http://localhost:4000
# DEBUG=true

# HOMOLOGAÇÃO:
# NGINX_PROXY_BACKEND=yes
# NGINX_PROXY_URL=http://api-backend:3000
# API_AUTH_URL=http://auth.hml.domain.com:4000

# PRODUÇÃO:
# NGINX_PROXY_BACKEND=yes
# NGINX_PROXY_URL=http://api-backend:3000
# API_AUTH_URL=http://auth.domain.com:4000
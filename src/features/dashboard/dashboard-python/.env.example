# Exemplo de Arquivo .env
# Copie este arquivo para .env e preencha com suas credenciais

# Configurações do Dashboard
DEBUG_MODE=True
PORT=8050
HOST=0.0.0.0

# Banco de Dados (exemplo PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vigilancia_saude
DB_USER=seu_usuario
DB_PASSWORD=sua_senha_aqui

# API (se usar)
API_URL=https://api.exemplo.com
API_KEY=sua_chave_api_aqui
API_TOKEN=seu_token_aqui

# Configurações de Cache
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# Segurança
SECRET_KEY=gere_uma_chave_secreta_forte_aqui
SESSION_TIMEOUT=3600

# Autenticação (se usar)
AUTH_USERNAME=admin
AUTH_PASSWORD=senha_muito_segura

# Logs
LOG_LEVEL=INFO
LOG_FILE=dashboard.log

# Timezone
TIMEZONE=America/Belem

# Exportação
EXPORT_DIR=exports/
MAX_EXPORT_SIZE=10000

# Atualização Automática
AUTO_REFRESH_INTERVAL=60
ENABLE_AUTO_REFRESH=True

# IMPORTANTE:
# 1. Nunca commite este arquivo com valores reais!
# 2. Adicione .env ao .gitignore
# 3. Use senhas fortes
# 4. Gere SECRET_KEY com: python -c "import secrets; print(secrets.token_hex(32))"
